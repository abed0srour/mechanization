# Copy to .env.local. These are inlined into the client bundle at build time —
# never put a secret here.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Powers the admin cadastral map's basemaps. Falls back to a checked-in
# personal token if unset — fine for local dev, but get your own before
# shipping (Mapbox meters usage per token).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# No Supabase keys: v2 dropped Supabase Auth, so the browser never talks to
# Supabase. Documents are reached through short-lived signed URLs the backend
# issues (and audits), not through a client-side SDK.
