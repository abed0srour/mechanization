{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": false,
    "paths": { "@shared/*": ["../../../packages/shared-schemas/src/*"] }
  },
  "include": ["src/**/*", "prisma/**/*"]
}
