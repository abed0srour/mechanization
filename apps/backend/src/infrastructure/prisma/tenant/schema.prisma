// ─────────────────────────  Per-tenant schema  ─────────────────────────
//
// Every model here is created once per municipality, inside that municipality's
// own Postgres schema (tenant_ashrafieh, tenant_zahle, ...). There is no
// `tenantId` column anywhere: the schema IS the tenant boundary. A query cannot
// read another municipality's rows because the connection is not pointed at
// that schema — not because a WHERE clause remembered to filter.
//
// Migrations here are applied to EVERY tenant schema by `migrate-all-tenants.ts`.
// Adding a model is therefore an O(tenants) operation, which is a loop at this
// scale and a reason to revisit only in the hundreds.

generator client {
  provider = "prisma-client-js"
  output   = "../../../generated/tenant-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────  Identity  ──────────────────────────────

/// Staff and citizens are one table with one JWT format and one guard.
/// Splitting them was how v1 ended up writing every tenant check twice.
enum UserKind {
  STAFF
  CITIZEN
}

enum StaffRole {
  SUPER_ADMIN
  AUDITOR
  FIELD_INSPECTOR
}

enum Gender {
  MALE
  FEMALE
}

/// صفة الإقامة — classifies the person, never the property.
enum ResidentStatus {
  REFUGEE
  DISPLACED
  VILLAGE_RESIDENT
}

/// الحالة الاجتماعية — asked in step 2 alongside the rest of the household picture.
enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum IdentityDocType {
  NATIONAL_ID
  FAMILY_RECORD
  DRIVER_LICENSE
  PASSPORT
}

model User {
  id   String   @id @default(uuid()) @db.Uuid
  kind UserKind

  /// Denormalised copy of the owning municipality's slug. Redundant with the
  /// schema itself, but it means a JWT's `tenantSlug` can be checked against the
  /// row it claims to authenticate — defence in depth against a factory bug
  /// handing out the wrong client.
  tenantSlug String

  // ── Staff-only ──
  email        String?
  passwordHash String?
  role         StaffRole?
  /// Base32 TOTP secret. Mandatory for SUPER_ADMIN before any session is issued.
  totpSecret     String?
  totpConfirmedAt DateTime?

  // ── Citizen-only ──
  phone    String?
  whatsapp String?

  firstName  String
  middleName String?
  lastName   String
  gender     Gender?

  nationality       String?
  isLebanese        Boolean?
  residencyNumber   String?
  residentStatus    ResidentStatus?
  identityDocType   IdentityDocType?
  identityDocNumber String?
  civilRecordNumber String?
  familySize        Int?
  maritalStatus     MaritalStatus?

  /// رقم مرجعي — usable when a phone is lost or shared.
  referenceNumber String? @unique

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registrations         Registration[]
  reviewedRegistrations Registration[] @relation("ReviewedBy")
  payments              CitizenPayment[]
  reviewedPayments      CitizenPayment[] @relation("PaymentReviewedBy")
  targetedFeeNotices    FeeNotice[]      @relation("FeeTargetCitizen")
  issuedFeeNotices      FeeNotice[]      @relation("FeeIssuedBy")

  /// Staff email is unique within the municipality (i.e. within this schema).
  @@unique([email])
  /// A household commonly shares one phone, so phone alone is not unique; the
  /// identity document is what distinguishes people. See the open question in
  /// docs/open-decisions.md about tolerating near-duplicate name spellings.
  @@unique([identityDocType, identityDocNumber])
  @@index([kind, phone])
  @@index([kind, role])
  @@map("users")
}

/// Short-lived phone-OTP challenges. Rows are disposable; a cleanup job prunes
/// expired ones so a stale code can never be replayed.
model OtpChallenge {
  id           String   @id @default(uuid()) @db.Uuid
  phone        String
  /// bcrypt hash — a leaked table must not hand out live login codes.
  codeHash     String
  /// Which delivery route issued it, so a failing provider is visible in data
  /// rather than only in logs. See the OTP fallback requirement in Section 10.
  channel      String   @default("PRIMARY")
  attempts     Int      @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

// ────────────────────────────  Registration  ────────────────────────────

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  APPROVED
  REJECTED
}

model Registration {
  id        String       @id @default(uuid()) @db.Uuid
  citizenId String       @db.Uuid
  citizen   User         @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  status    ReportStatus @default(PENDING)

  referenceNumber String  @unique
  rejectionReason String?

  /// Which specific fields the reviewer flagged as wrong, as dot-paths the
  /// applicant's form can resolve back to an input — `personal.firstName`, or
  /// `property.0.propertyNumber` for a repeated card. Empty on a whole-claim
  /// rejection, which stays a valid outcome: not every refusal is a
  /// correctable mistake.
  ///
  /// Denormalised onto the registration rather than a join table because it
  /// is read as one blob (render the applicant's form) and written as one
  /// blob (the reviewer submits the whole set at once) — a row per flag would
  /// buy queryability nothing here asks for.
  rejectedFields  String[] @default([])

  /// Whether the citizen may fix the flagged fields themselves.
  ///
  /// Default true: a wrong digit is a wrong digit, and making someone travel
  /// to the municipality to change one is the outcome this system exists to
  /// avoid. False is the deliberate exception — an original document has to be
  /// seen, or an identity verified in person — and it turns the citizen's
  /// correction form into an instruction to visit instead.
  citizenCanCorrect Boolean @default(true)

  /// Optional appointment for that visit. Only meaningful when
  /// `citizenCanCorrect` is false; null there simply means "come when you can".
  revisitAt DateTime?

  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties PropertyEntry[]
  documents  Document[]

  @@index([status, submittedAt])
  @@index([citizenId])
  @@map("registrations")
}

enum OccupancyType {
  OWNER
  TENANT
}

enum PropertyType {
  BUILDING
  HOUSE
  LAND
  TENT
}

enum UnitType {
  APARTMENT
  CLINIC
  SHOP
}

enum LandType {
  AGRICULTURAL
  INDUSTRIAL
}

/// One row per property card. A citizen may register many.
model PropertyEntry {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  occupancyType OccupancyType
  landlordName  String?
  landlordPhone String?

  propertyType   PropertyType
  /// الحي — common to every property type. Free text: unlike رقم العقار there is
  /// no neighbourhood layer in the cadastre to check it against.
  neighborhood   String
  /// رقم العقار as printed on the deed. Deliberately NOT unique: an apartment
  /// building is one cadastral number shared by every owner and tenant inside
  /// it, so co-registration is the normal case. Uniqueness here used to tell the
  /// second resident of a building that their own address was already taken.
  propertyNumber String
  /// unitType/floor/side/unitArea/sharedRights describe a single unit, which is
  /// all a HOUSE or a LAND ever has. A BUILDING reads its units from
  /// `units` instead — see BuildingUnit.
  unitType       UnitType?
  landType       LandType?
  buildingName   String?
  floor          String?
  side           String?
  tentLocation   String?
  unitArea       Decimal?      @db.Decimal(12, 2)
  sharedRights   String[]      @default([])

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  units     BuildingUnit[]

  @@index([propertyType])
  @@index([propertyNumber])
  @@index([latitude, longitude])
  @@map("property_entries")
}

/// One unit inside a BUILDING — شقة, عيادة or محل.
///
/// Owning a whole building is one عقار with many units, not many عقارات: the
/// parcel has a single رقم العقار, and `PropertyEntry.propertyNumber` is unique
/// precisely so the cadastre lookup can trust it. Units therefore hang off the
/// parcel rather than duplicating it.
model BuildingUnit {
  id              String        @id @default(uuid()) @db.Uuid
  propertyEntryId String        @db.Uuid
  propertyEntry   PropertyEntry @relation(fields: [propertyEntryId], references: [id], onDelete: Cascade)

  unitType     UnitType
  floor        String
  side         String?
  unitArea     Decimal  @db.Decimal(12, 2)
  sharedRights String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyEntryId])
  @@map("building_units")
}

// ────────────────────────────  Cadastre  ────────────────────────────

/// The municipality's official parcel registry (رقم العقار), imported from the
/// survey office's KMZ by `cadastre:import`.
///
/// This is what makes رقم العقار checkable instead of merely well-formed: a
/// number either exists in the municipality's cadastre or it does not, and the
/// citizen finds out while typing rather than three weeks later when a clerk
/// cannot locate the property.
///
/// It also replaces the citizen-facing location picker. The parcel already has
/// authoritative coordinates from the survey, so asking someone to drop a pin on
/// a satellite image only invites a worse answer to a question already answered.
///
/// A municipality with no rows here keeps the old behaviour — any well-formed
/// number is accepted — so tenants can onboard before their cadastre is ready.
model Parcel {
  id String @id @default(uuid()) @db.Uuid

  /// As printed on the deed. Unique within this municipality, which the schema
  /// boundary already guarantees.
  parcelNumber String @unique

  /// Representative point for the parcel. Where the source drew a parcel with
  /// several label points, this is their centroid.
  latitude  Float
  longitude Float

  /// How many source points were merged into the centroid above. > 1 means the
  /// survey split this parcel, so the point is an approximation of a shape that
  /// is not contiguous.
  pointCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@map("parcels")
}

/// An administrative sector (قطاع) the municipality draws over its own cadastre.
///
/// Unlike the parcel registry above, this is the municipality's own construct
/// rather than the survey office's: staff group parcels into sectors to assign
/// field inspectors, report registration coverage per area, and filter the map
/// down to a neighbourhood. Nothing outside the municipality knows these exist.
///
/// Membership is stored as the parcel *numbers* rather than as a relation to
/// `Parcel`. A cadastre re-import rebuilds the parcel table wholesale (see
/// `cadastre:import`), which would cascade away every zone's contents on a
/// routine survey correction. Parcel numbers are what the deed prints and what
/// staff actually type, so keeping them here lets a zone outlive the re-import
/// and simply reference a number the new cadastre may or may not still carry.
model Zone {
  id String @id @default(uuid()) @db.Uuid

  /// Free text as the municipality words it, e.g. "المنطقة الشرقية - قطاع أ".
  name String

  /// Short handle staff use in conversation and reports, e.g. "SEC-A1".
  code String @unique

  /// Hex fill this zone draws with on the map, `#RRGGBB`. Validated in the zone
  /// schema rather than by a Postgres type, matching how tenant branding colours
  /// are handled in the registry.
  color String @default("#3B82F6")

  description String?

  /// The رقم العقار values belonging to this zone. A number may appear in only
  /// one zone at a time; the service enforces that, since Postgres cannot
  /// express uniqueness across the elements of an array.
  parcelNumbers String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("zones")
}

enum DocumentType {
  IDENTITY
  OWNERSHIP_PROOF
  RENTAL_CONTRACT
  RESIDENCY_PROOF
  EXTRA_PHOTO
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  /// Null for person-level documents (identity); set for per-property proofs.
  propertyEntryId String?        @db.Uuid
  propertyEntry   PropertyEntry? @relation(fields: [propertyEntryId], references: [id], onDelete: Cascade)

  type        DocumentType
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime     @default(now())

  @@index([registrationId])
  @@map("documents")
}

// ──────────────────────────────  Audit  ──────────────────────────────

/// Append-only. Nothing in the application layer updates or deletes these rows;
/// a per-schema trigger (see the tenant migration) enforces that at the DB level
/// so a future bug cannot quietly rewrite history.
model AuditLogEntry {
  id String @id @default(uuid()) @db.Uuid

  actorId    String?    @db.Uuid
  actorType  String     @default("STAFF")
  actorRole  StaffRole?
  actorEmail String?

  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_log_entries")
}

// ──────────────────────────  Fees & payments  ──────────────────────────

/// Municipality-wide configuration a clerk can change without a deploy.
///
/// A single row per tenant, enforced by `singleton` rather than by convention:
/// two rows would mean two Whish numbers, and the citizen portal would have no
/// way to know which one to print on the payment instructions.
model SystemSettings {
  id String @id @default(uuid()) @db.Uuid

  /// Guaranteed unique, so `upsert` always targets the same row.
  singleton Boolean @unique @default(true)

  /// The number citizens transfer to. Nullable because a municipality that has
  /// not set one yet must not have the portal invent a plausible-looking one —
  /// the Whish option is hidden instead.
  whishMoneyNumber String?

  /// Shown beside the "pay at the municipality" option. Free text: opening
  /// hours are a local arrangement, not something to model.
  cashOfficeHours   String?
  cashOfficeAddress String?

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("system_settings")
}

enum FeeFrequency {
  ONCE
  MONTHLY
  HALF_YEARLY
  ANNUALLY
}

enum FeeTargetType {
  ALL_CITIZENS
  BUILDING_CATEGORY
  INDIVIDUAL_CITIZEN
}

enum PaymentStatus {
  UNPAID
  PENDING_REVIEW
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  WHISH_MONEY
}

/// The rule an administrator writes once: "500,000 LBP of رسم النفايات, every
/// month, for every resident". Issuing it fans out into one `CitizenPayment`
/// per matching citizen — this row is the template, never the debt.
model FeeNotice {
  id       String  @id @default(uuid()) @db.Uuid
  title    String
  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("LBP")

  frequency  FeeFrequency
  targetType FeeTargetType

  /// For BUILDING_CATEGORY: a `PropertyType` or `UnitType` value, kept as text
  /// because it spans two enums and neither owns the other.
  targetCategory  String?
  targetCitizenId String? @db.Uuid
  targetCitizen   User?   @relation("FeeTargetCitizen", fields: [targetCitizenId], references: [id])

  dueDate DateTime
  /// Shown to the citizen above the payment options.
  instructions String?

  /// Whether the recurring biller still re-issues this notice each period.
  /// A recurring charge with no off switch would bill a municipality's
  /// residents forever; stopping it leaves every invoice already raised
  /// exactly as it stands.
  isActive Boolean @default(true)

  issuedById String? @db.Uuid
  issuedBy   User?   @relation("FeeIssuedBy", fields: [issuedById], references: [id])

  createdAt DateTime         @default(now())
  payments  CitizenPayment[]

  @@index([targetType])
  @@map("fee_notices")
}

/// One citizen's debt. Denormalises `title`/`amount` off the notice on purpose:
/// a clerk correcting next month's fee must not silently rewrite what someone
/// already paid last month.
model CitizenPayment {
  id        String @id @default(uuid()) @db.Uuid
  citizenId String @db.Uuid
  citizen   User   @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  /// Null for a one-off charge raised directly against a citizen.
  feeNoticeId String?    @db.Uuid
  feeNotice   FeeNotice? @relation(fields: [feeNoticeId], references: [id], onDelete: SetNull)

  title    String
  amount   Decimal  @db.Decimal(14, 2)
  currency String   @default("LBP")
  dueDate  DateTime

  paymentStatus PaymentStatus  @default(UNPAID)
  paymentMethod PaymentMethod?

  /// What the citizen typed off their Whish receipt. Not verified by us — a
  /// clerk confirms it against the municipality's own account, which is the
  /// whole reason PENDING_REVIEW exists between UNPAID and PAID.
  whishTransactionRef String?
  receiptPath         String?

  paidAt       DateTime?
  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("PaymentReviewedBy", fields: [reviewedById], references: [id])
  /// Why a clerk sent a claimed payment back to UNPAID.
  reviewNote String?

  /// Which billing period this invoice covers: `2026-07`, `2026-H2`, `2026`,
  /// or `ONCE`. Written rather than derived so the uniqueness below is a
  /// database guarantee — the recurring job's safety against double-billing
  /// cannot depend on it remembering to check first.
  periodKey String @default("ONCE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The portal's main read: this citizen's outstanding balance.
  @@index([citizenId, paymentStatus])
  /// The admin queue: what is awaiting verification, oldest first.
  @@index([paymentStatus, dueDate])
  /// One invoice per citizen, per notice, **per period**. Re-running July's
  /// billing is a no-op; August's is a new row. Without the period the
  /// monthly fee could only ever be charged once.
  @@unique([citizenId, feeNoticeId, periodKey])
  @@map("citizen_payments")
}
