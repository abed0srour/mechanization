{
  "name": "@mechanization/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start:prod": "node dist/presentation/main",
    "prisma:generate": "pnpm prisma:generate:registry && pnpm prisma:generate:tenant",
    "prisma:generate:registry": "prisma generate --schema src/infrastructure/prisma/registry/schema.prisma",
    "prisma:generate:tenant": "prisma generate --schema src/infrastructure/prisma/tenant/schema.prisma",
    "prisma:migrate:registry": "prisma migrate dev --schema src/infrastructure/prisma/registry/schema.prisma",
    "prisma:migrate:tenant": "prisma migrate dev --schema src/infrastructure/prisma/tenant/schema.prisma --create-only",
    "prisma:deploy:registry": "prisma migrate deploy --schema src/infrastructure/prisma/registry/schema.prisma",
    "tenant:provision": "ts-node -r tsconfig-paths/register src/infrastructure/prisma/provision-tenant.ts",
    "tenant:migrate-all": "ts-node -r tsconfig-paths/register src/infrastructure/prisma/migrate-all-tenants.ts",
    "cadastre:import": "ts-node -r tsconfig-paths/register src/infrastructure/cadastre/import-parcels.ts",
    "seed": "ts-node -r tsconfig-paths/register src/infrastructure/prisma/seed.ts",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@mechanization/shared-schemas": "workspace:*",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.46.1",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "helmet": "^8.0.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
