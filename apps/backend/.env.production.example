# ── PRODUCTION — template only ───────────────────────────────────────────
#
# Project: thbgwfbcqdougbjvgvyw
#
# There is deliberately no `.env.production` in this repository, and on a
# working laptop there should not be one either.
#
# Production credentials belong in GitHub Environment secrets, where the deploy
# workflow reads them and where granting or revoking access is an auditable act.
# A copy on a developer's disk is a credential with no expiry, no audit trail
# and no revocation path — and it is the single thing that makes "I ran the
# wrong command" able to reach live municipal records.
#
# The normal way to migrate production is therefore:
#
#     GitHub → Actions → "Deploy production" → Run workflow
#
# which requires a reviewer's approval before it touches anything.
#
# ── If you genuinely need to run it locally ──────────────────────────────
#
# A break-glass case — CI is down and something is broken in production:
#
#   1. cp apps/backend/.env.production.example apps/backend/.env.production
#   2. Fill it from the dashboard.
#   3. pnpm db:deploy:production          (it will make you type the ref)
#   4. rm apps/backend/.env.production    ← do not skip this
#
# Step 4 is the one people skip. The file is gitignored, so nothing will ever
# remind you it is still there.

NODE_ENV=production
PORT=4000

DATABASE_URL="postgresql://postgres.thbgwfbcqdougbjvgvyw:<PRODUCTION-DB-PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.thbgwfbcqdougbjvgvyw:<PRODUCTION-DB-PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://thbgwfbcqdougbjvgvyw.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<PRODUCTION-SERVICE-ROLE-KEY>"
SUPABASE_STORAGE_BUCKET="documents"

# Must differ from staging's. Sharing one secret across environments means a
# staging token opens production. openssl rand -base64 48
JWT_SECRET="<GENERATE-ME-DISTINCT-FROM-STAGING>"
JWT_STAFF_TTL="8h"
JWT_STAFF_REMEMBER_TTL="30d"
JWT_CITIZEN_TTL="7d"

# Both required — the env schema refuses to boot production without them.
OTP_ENABLED="true"
SMS_PROVIDER_API_KEY="<LIVE-SMS-KEY>"
SMS_PROVIDER_FALLBACK_API_KEY="<LIVE-SMS-FALLBACK-KEY>"

CORS_ORIGINS="https://<web>.vercel.app"
PUBLIC_API_URL="https://<api>.vercel.app/api/v1"
PUBLIC_PORTAL_URL="https://<web>.vercel.app"

CRON_SECRET="<GENERATE-ME>"

DASHBOARD_CACHE_TTL_SECONDS=60
