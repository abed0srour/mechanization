# Copy to .env and fill in. Never commit the filled version.
#
# Boot validates this against `presentation/config/env.schema.ts` and fails
# fast: a portal running without a JWT secret is worse than one that refuses to
# start.
#
# ── Which file is which ─────────────────────────────────────────────────
#
#   .env                     local development. Addresses the STAGING project.
#   .env.staging             the staging deploy.
#   .env.production          does not exist here, and should not exist on your
#                            machine either — see .env.production.example.
#
# Each is pinned to a Supabase project ref in `scripts/db/targets.mjs`, and
# every db: script refuses to run when a file names a different one. `pnpm dev`
# runs that check before it boots, so a production connection string pasted into
# `.env` stops the dev server rather than silently attaching the app to live
# municipal records. `pnpm db:check` runs it on demand.
#
# Full workflow: docs/database-environments.md

NODE_ENV=development
PORT=4000

# ── Database (Supabase Postgres) ───────────────────────────────────────
# Pooled connection (transaction mode, port 6543) for the running app. The
# tenant client factory rewrites the `schema` parameter per municipality, so
# this URL must survive having a query parameter added to it.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (session mode, port 5432) for migrations and schema DDL.
# Provisioning creates schemas, types and triggers, which is unreliable through
# a transaction pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ── Supabase (storage only) ────────────────────────────────────────────
# v2 dropped Supabase Auth — there is no SUPABASE_JWT_SECRET any more, because
# this backend now issues every token itself. Storage is unaffected.
SUPABASE_URL="https://<project-ref>.supabase.co"
# Server-side only. If this reaches a browser bundle, every municipality's
# scanned identity documents are readable by anyone.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="documents"

# ── Auth (citizens and staff share one issuer) ─────────────────────────
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="<generate-me-do-not-reuse-anything-pasted-into-a-chat-or-ticket>"
JWT_STAFF_TTL="12h"
# Issued instead of JWT_STAFF_TTL when a staff member checks "تذكّرني على هذا الجهاز".
JWT_STAFF_REMEMBER_TTL="30d"
JWT_CITIZEN_TTL="7d"

# ── OTP delivery ───────────────────────────────────────────────────────
# Citizen one-time-password verification. Set to false to sign in with a phone
# number alone while no SMS provider is wired up — the code is all still there,
# it is simply not demanded. Production refuses to boot with this off: these
# records hold national ID numbers, addresses and refugee status, and a phone
# number is not a secret. Anything unrecognised is treated as "true".
OTP_ENABLED="true"

# Optional, and currently inert everywhere. No provider has been chosen, so
# `SmsProviderService.deliver()` throws whether or not these are set — an OTP is
# no more deliverable with both keys than with neither. Production used to
# refuse to boot without them; that check was removed because it enforced a
# boot failure rather than a working login path.
#
# Two routes remain the intended design (docs/open-decisions.md #2): one SMS
# provider is a single point of failure on the login path, and the citizens
# locked out by it are the ones this system exists to serve. Set both, and
# restore the boot check in env.schema.ts, in the change that implements
# `deliver()`.
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_FALLBACK_API_KEY=""

# ── Runtime ────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000"

# ── Dashboard cache (optional) ──────────────────────────────────────────
# Unset means every dashboard/map read goes straight to Postgres — correct,
# just uncached. Set this to actually get the cached fast path.
REDIS_URL="redis://localhost:6379"
DASHBOARD_CACHE_TTL_SECONDS=60

# ── Deployment (Vercel) ────────────────────────────────────────────────
# Absolute URLs handed to third parties and to the browser. Localhost defaults
# apply when unset, which is wrong anywhere but a laptop.
PUBLIC_API_URL="https://<api-project>.vercel.app/api/v1"
PUBLIC_PORTAL_URL="https://<web-project>.vercel.app"

# Shared secret for the Vercel Cron endpoints. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET` on every scheduled invocation; the
# endpoints refuse to run when it is unset. Not needed for Docker/local, where
# ScheduleModule still runs the jobs in process.
# Generate with: openssl rand -hex 32
CRON_SECRET="<generate-me>"
