# Copy to .env and fill in. Never commit the filled version.
#
# Boot validates this against `presentation/config/env.schema.ts` and fails
# fast: a portal running without a JWT secret is worse than one that refuses to
# start.

NODE_ENV=development
PORT=4000

# ── Database (Supabase Postgres) ───────────────────────────────────────
# Pooled connection (transaction mode, port 6543) for the running app. The
# tenant client factory rewrites the `schema` parameter per municipality, so
# this URL must survive having a query parameter added to it.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (session mode, port 5432) for migrations and schema DDL.
# Provisioning creates schemas, types and triggers, which is unreliable through
# a transaction pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ── Supabase (storage only) ────────────────────────────────────────────
# v2 dropped Supabase Auth — there is no SUPABASE_JWT_SECRET any more, because
# this backend now issues every token itself. Storage is unaffected.
SUPABASE_URL="https://<project-ref>.supabase.co"
# Server-side only. If this reaches a browser bundle, every municipality's
# scanned identity documents are readable by anyone.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="documents"

# ── Auth (citizens and staff share one issuer) ─────────────────────────
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="<generate-me-do-not-reuse-anything-pasted-into-a-chat-or-ticket>"
JWT_STAFF_TTL="12h"
JWT_CITIZEN_TTL="7d"

# ── OTP delivery ───────────────────────────────────────────────────────
# Production refuses to boot without both. A single SMS route is a single point
# of failure on the login path, and the citizens locked out by it are the ones
# this system exists to serve. See docs/open-decisions.md #2.
SMS_PROVIDER_API_KEY="<sms-provider-key>"
SMS_PROVIDER_FALLBACK_API_KEY="<second-route-key>"

# ── Runtime ────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000"
