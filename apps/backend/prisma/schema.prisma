// Municipality multi-tenant platform — data model.
// Every citizen-facing table carries `tenantId` and is protected by a Postgres
// RLS policy (see prisma/migrations/*_rls_policies). Application-level scoping
// via the Prisma tenant extension is defence-in-depth, not the only guard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────  Tenancy  ─────────────────────────────

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  nameAr    String
  isActive  Boolean  @default(true)
  /// Hidden admin path segment, e.g. "admin-portal-x7b2". Unique per tenant.
  adminPathSegment String @unique
  /// Branding + per-municipality wizard configuration (enabled property types,
  /// required documents, colours, logo URL).
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff         MunicipalityUser[]
  citizens      Citizen[]
  registrations Registration[]
  properties    PropertyEntry[]
  documents     Document[]
  auditLogs     AuditLogEntry[]

  @@map("tenants")
}

// ──────────────────────────  Staff identity  ──────────────────────────

enum StaffRole {
  SUPER_ADMIN
  AUDITOR
  FIELD_INSPECTOR
}

model MunicipalityUser {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  fullName     String
  role         StaffRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reviewedRegistrations Registration[] @relation("ReviewedBy")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("municipality_users")
}

// ─────────────────────────  Citizen identity  ─────────────────────────

enum Gender {
  MALE
  FEMALE
}

/// صفة الإقامة — describes the person, never the property.
enum ResidentStatus {
  REFUGEE
  DISPLACED
  VILLAGE_RESIDENT
}

enum IdentityDocType {
  NATIONAL_ID
  FAMILY_RECORD
  DRIVER_LICENSE
  PASSPORT
}

model Citizen {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Supabase Auth user id. Null until the citizen first verifies an OTP —
  /// a form can be submitted before an account session exists.
  supabaseUserId String?

  phone    String
  whatsapp String

  firstName  String
  middleName String?
  lastName   String
  gender     Gender

  nationality       String
  isLebanese        Boolean
  residencyNumber   String?
  residentStatus    ResidentStatus
  identityDocType   IdentityDocType
  identityDocNumber String
  civilRecordNumber String
  familySize        Int

  /// رقم مرجعي — shown on screen, sent by SMS, and usable when a phone is lost.
  referenceNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]

  @@unique([tenantId, referenceNumber])
  /// A household commonly shares one phone, so the phone alone is not unique;
  /// the identity document is what distinguishes people within a municipality.
  @@unique([tenantId, identityDocType, identityDocNumber])
  @@index([tenantId, phone])
  @@index([tenantId, supabaseUserId])
  @@map("citizens")
}

// ──────────────────────────  Registration  ──────────────────────────

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  APPROVED
  REJECTED
}

model Registration {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citizenId String       @db.Uuid
  citizen   Citizen      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  status    ReportStatus @default(PENDING)

  referenceNumber String
  rejectionReason String?

  reviewedById String?           @db.Uuid
  reviewedBy   MunicipalityUser? @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties PropertyEntry[]
  documents  Document[]

  @@unique([tenantId, referenceNumber])
  @@index([tenantId, status, submittedAt])
  @@index([tenantId, citizenId])
  @@map("registrations")
}

enum OccupancyType {
  OWNER
  TENANT
}

enum PropertyType {
  BUILDING
  HOUSE
  LAND
  TENT
}

enum UnitType {
  APARTMENT
  CLINIC
  SHOP
}

enum LandType {
  AGRICULTURAL
  INDUSTRIAL
}

/// One row per property card. A citizen may register many.
model PropertyEntry {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrationId String       @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  occupancyType OccupancyType
  landlordName  String?
  landlordPhone String?

  propertyType   PropertyType
  propertyNumber String
  unitType       UnitType?
  landType       LandType?
  buildingName   String?
  floor          String?
  side           String?
  tentLocation   String?
  unitArea       Decimal? @db.Decimal(12, 2)
  sharedRights   String[] @default([])

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  /// Uniqueness is scoped to the municipality: two municipalities may each
  /// legitimately have a property numbered "123".
  @@unique([tenantId, propertyNumber])
  @@index([tenantId, propertyType])
  @@index([tenantId, latitude, longitude])
  @@map("property_entries")
}

enum DocumentType {
  IDENTITY
  OWNERSHIP_PROOF
  RENTAL_CONTRACT
  RESIDENCY_PROOF
  EXTRA_PHOTO
}

model Document {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrationId String        @db.Uuid
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  /// Null for person-level documents (identity); set for per-property proofs.
  propertyEntryId String?       @db.Uuid
  propertyEntry   PropertyEntry? @relation(fields: [propertyEntryId], references: [id], onDelete: Cascade)

  type        DocumentType
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime     @default(now())

  @@index([tenantId, registrationId])
  @@map("documents")
}

// ─────────────────────────────  Audit  ─────────────────────────────

model AuditLogEntry {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorId   String?    @db.Uuid
  actorType String     @default("STAFF")
  actorRole StaffRole?
  actorEmail String?

  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, actorId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_log_entries")
}
